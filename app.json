{
  "expo": {
    "name": "AgriNex",
    "slug": "agrinex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agrinex",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#10B981",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7FAFC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7FAFC"
      },
      "package": "com.agrinex.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "androidStatusBar": {
      "backgroundColor": "#F7FAFC",
      "barStyle": "dark-content",
      "translucent": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#F7FAFC",
      "barStyle": "dark-content"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6581ba6-3553-4adc-b276-ae37ae7f1257"
      }
    },
    "owner": "sweetyroselin"
  }
}